{
  "name": "shiori-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run assets && astro dev --host 127.0.0.1",
    "check": "npm run assets && astro check",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run assets && astro build && node scripts/check-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "astro": "7.4.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "22.20.5",
    "playwright": "1.64.1",
    "typescript": "6.0.3"
  }
}
