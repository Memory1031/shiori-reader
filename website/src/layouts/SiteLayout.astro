---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { copy } from '../i18n/copy';
import { route, media, type Locale } from '../lib/paths';
interface Props { locale: Locale; page?: string; }
const { locale, page = '' } = Astro.props, t = copy[locale];
const title = page === 'download' ? `${t.nav[1]} Shiori — ${t.downloads.title}` : t.title;
const canonical = new URL(route(locale, page), Astro.site).href;
const image = new URL(media(`share-${locale === 'en' ? 'en' : 'zh'}.jpg`), Astro.site).href;
---
<!doctype html>
<html lang={locale === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="theme-color" content="#faf8f4" /><title>{title}</title>
    <meta name="description" content={t.description} /><link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(route('zh-cn', page), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(route('en', page), Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(route('zh-cn', page), Astro.site)} />
    <meta property="og:type" content="website" /><meta property="og:site_name" content="Shiori Reader" />
    <meta property="og:title" content={title} /><meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} /><meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={locale === 'en' ? 'Shiori and the original demo novel cover' : 'Shiori 与原创演示小说封面'} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_CN'} />
    <meta name="twitter:card" content="summary_large_image" /><link rel="icon" type="image/png" href={media('favicon.png')} />
    <link rel="sitemap" href="/shiori-reader/sitemap.xml" />
  </head>
  <body>
    <SiteHeader locale={locale} page={page} />
    <main id="main"><slot /></main>
    <SiteFooter locale={locale} page={page} />
  </body>
</html>
