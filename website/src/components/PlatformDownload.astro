---
import { copy } from '../i18n/copy';
import GitHubIcon from './GitHubIcon.astro';
import { platforms } from '../lib/releases';
import { latestRelease, repository, route, type Locale } from '../lib/paths';
interface Props { locale: Locale; full?: boolean; }
const { locale, full = false } = Astro.props, t = copy[locale].downloads;
const names = { android: 'Android', windows: 'Windows', macos: 'macOS', ios: 'iOS / iPadOS' };
const icons = { android: 'M6 10h12v9H6zM8 6l-2-3m10 3 2-3M6 8a6 6 0 0 1 12 0M3 11v6m18-6v6M9 19v3m6-3v3', windows: 'M3 5l8-1v8H3zm10-1 8-1v9h-8zM3 14h8v8l-8-1zm10 0h8v9l-8-1z', macos: 'M7 5h10a2 2 0 0 1 2 2v11H5V7a2 2 0 0 1 2-2ZM2 21h20', ios: 'M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm2 17h4' };
---
<section class:list={['download-section section', { full }]} id="download" data-download data-locale={locale}>
  <div class="wrap">
    <div class="section-heading"><p class="section-label">{t.label}</p>{full ? <h1>{t.title}</h1> : <h2>{t.title}</h2>}<p class="lead">{t.body}</p></div>
    <div class="download-box">
      <div class="platform-tabs" role="tablist" aria-label={locale === 'en' ? 'Download platform' : '下载平台'}>
        {platforms.map((platform, i) => <button disabled type="button" role="tab" id={`tab-${platform}`} aria-controls="package-panel" aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-platform={platform}><svg width="24" height="24" viewBox="0 0 24 26" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[platform]} /></svg>{names[platform]}</button>)}
      </div>
      <div id="package-panel" class="package-panel" role="tabpanel" aria-labelledby="tab-android" tabindex="0">
        <div class="package-summary"><div><p class="release-state" data-status role="status" aria-live="polite">{t.initial}</p><h3 data-platform-name>Android</h3><p data-requirements>{t.requirements.android}</p></div><span class="package-version" data-version></span></div>
        <dl class="package-meta" data-meta hidden><div><dt>{t.date}</dt><dd data-date></dd></div><div><dt>{t.size}</dt><dd data-size></dd></div></dl>
        <div class="package-actions"><a class="button primary" data-package hidden>{t.action}<span aria-hidden="true">↓</span></a><a class="text-link" data-portable hidden>{t.portableAction}</a><a class="text-link" href={latestRelease}><GitHubIcon />{t.fallback}</a><button class="text-link" type="button" data-retry hidden>{t.retry}</button></div>
        {!full && <div class="install-summary"><p data-install-note>{t.quickInstall.android}</p><a class="text-link" data-install-guide href={`${route(locale, 'download')}#install-android`}>{t.guide} <span aria-hidden="true">↗</span></a></div>}
        <p class="fine">{t.apiNote}</p><noscript><p>{t.nojs}</p></noscript>
      </div>
    </div>
    {full && <div class="installation"><h2>{t.installTitle}</h2><div class="install-grid">{platforms.map(platform => <article id={`install-${platform}`}><h3>{names[platform]}<span>{t.requirements[platform]}</span></h3><ol>{t.install[platform].map(step => <li>{step}</li>)}</ol></article>)}</div><p class="fine">{t.update} <a href={`${repository}/releases`}>{t.all} ↗</a></p></div>}
  </div>
</section>
<script>
  import { copy } from '../i18n/copy';
  import { loadRelease, ReleaseError, platforms, type Platform, type Release, type ErrorKind } from '../lib/releases';
  import type { Locale } from '../lib/paths';
  import { route } from '../lib/paths';
  const names = { android: 'Android', windows: 'Windows', macos: 'macOS', ios: 'iOS / iPadOS' };
  document.querySelectorAll<HTMLElement>('[data-download]').forEach(root => {
    const locale = root.dataset.locale as Locale, t = copy[locale].downloads;
    const get = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-platform]'));
    let selected: Platform = 'android', release: Release | undefined, failure: ErrorKind | undefined;
    const userAgent = navigator.userAgent;
    if (/Windows/i.test(userAgent)) selected = 'windows';
    else if (/iPhone|iPad|iPod/i.test(userAgent) || (/Macintosh/i.test(userAgent) && navigator.maxTouchPoints > 1)) selected = 'ios';
    else if (/Macintosh|Mac OS X/i.test(userAgent)) selected = 'macos';
    const render = () => {
      tabs.forEach(tab => { const active = tab.dataset.platform === selected; tab.disabled = false; tab.tabIndex = active ? 0 : -1; tab.setAttribute('aria-selected', String(active)); });
      get('#package-panel').setAttribute('aria-labelledby', `tab-${selected}`);
      get('[data-platform-name]').textContent = names[selected];
      get('[data-requirements]').textContent = t.requirements[selected];
      const note = root.querySelector<HTMLElement>('[data-install-note]');
      const guide = root.querySelector<HTMLAnchorElement>('[data-install-guide]');
      if (note) note.textContent = t.quickInstall[selected];
      if (guide) guide.href = `${route(locale, 'download')}#install-${selected}`;
      get('[data-version]').textContent = release?.tag ?? '';
      const setup = selected === 'windows' ? release?.downloads.windows : undefined;
      const portable = selected === 'windows' ? release?.downloads.windowsPortable : undefined;
      const asset = release?.downloads[selected] ?? portable;
      get('[data-status]').textContent = failure ? t.errors[failure] : release ? asset ? t.ready : t.missing : t.loading;
      get('[data-retry]').hidden = !failure;
      const link = get<HTMLAnchorElement>('[data-package]');
      link.hidden = !asset;
      link.removeAttribute('href');
      if (asset) { link.href = asset.url; link.textContent = `${selected === 'ios' ? t.iosAction : selected === 'windows' ? setup ? t.setupAction : t.portableAction : t.action} ↓`; }
      const portableLink = get<HTMLAnchorElement>('[data-portable]');
      portableLink.hidden = !setup || !portable;
      portableLink.removeAttribute('href');
      if (setup && portable) { portableLink.href = portable.url; portableLink.textContent = `${t.portableAction} · ${new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(portable.size / 1_000_000)} MB ↓`; }
      get('[data-meta]').hidden = !asset;
      get('[data-date]').textContent = release ? new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' }).format(new Date(release.date)) : '';
      get('[data-size]').textContent = asset ? `${new Intl.NumberFormat(locale, { maximumFractionDigits: 1 }).format(asset.size / 1_000_000)} MB` : '';
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => { selected = tab.dataset.platform as Platform; render(); });
      tab.addEventListener('keydown', event => {
        const delta = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + delta + tabs.length) % tabs.length;
        if (delta || event.key === 'Home' || event.key === 'End') { event.preventDefault(); selected = platforms[next]!; render(); tabs[next]!.focus(); }
      });
    });
    let generation = 0;
    const load = async (retry = false) => {
      const request = ++generation;
      failure = undefined; release = undefined; render();
      root.setAttribute('aria-busy', 'true');
      try { const result = await loadRelease(retry); if (request === generation) release = result; }
      catch (error) { if (request === generation) failure = error instanceof ReleaseError ? error.kind : 'network'; }
      finally { if (request === generation) { root.setAttribute('aria-busy', 'false'); render(); } }
    };
    get('[data-retry]').addEventListener('click', () => void load(true));
    void load();
  });
</script>
