---
import { copy } from '../i18n/copy';
import { repository, type Locale } from '../lib/paths';
interface Props { locale: Locale; }
const { locale } = Astro.props, t = copy[locale];
---
<section id="faq" class="section wrap faq"><h2>{t.faqTitle}</h2><div class="faq-list">{t.faqs.map(item => <details><summary>{item.q}<span aria-hidden="true">+</span></summary><p>{item.a}</p></details>)}<a class="text-link" href={`${repository}/issues`}>{t.footer.issues} ↗</a></div></section>
<section id="privacy" class="privacy wrap"><h2>{t.privacy.title}</h2><div><p>{t.privacy.body}</p><p>{t.privacy.third}</p><p>{t.privacy.relation}</p><p>{t.privacy.license}</p></div></section>
