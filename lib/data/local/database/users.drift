CREATE TABLE bookshelf (
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL, summary_json TEXT NOT NULL,
 added_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
 PRIMARY KEY(source_id, novel_id)
);
CREATE INDEX bookshelf_added ON bookshelf(added_at DESC);
CREATE TABLE progress_sessions (
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL,
 generation INTEGER NOT NULL CHECK(generation >= 1),
 sequence INTEGER NOT NULL DEFAULT -1 CHECK(sequence >= -1),
 removal_generation INTEGER NOT NULL DEFAULT 0 CHECK(removal_generation >= 0),
 PRIMARY KEY(source_id, novel_id)
);
CREATE TABLE reading_progress (
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL, chapter_id TEXT NOT NULL,
 summary_json TEXT NOT NULL, chapter_ordinal INTEGER NOT NULL CHECK(chapter_ordinal >= 0),
 catalog_revision TEXT NOT NULL, content_revision TEXT NOT NULL, block_key TEXT NOT NULL,
 block_index INTEGER NOT NULL CHECK(block_index >= 0),
 block_fraction REAL NOT NULL CHECK(block_fraction >= 0 AND block_fraction <= 1),
 chapter_fraction REAL NOT NULL CHECK(chapter_fraction >= 0 AND chapter_fraction <= 1),
 book_progress TEXT,
 completed INTEGER NOT NULL CHECK(completed IN (0, 1)),
 pixel_offset REAL CHECK(pixel_offset >= 0), layout_key TEXT,
 position_version INTEGER NOT NULL CHECK(position_version >= 1),
 last_read_at INTEGER NOT NULL, updated_at INTEGER NOT NULL,
 CHECK((pixel_offset IS NULL) = (layout_key IS NULL)),
 PRIMARY KEY(source_id, novel_id)
);
CREATE INDEX progress_recent ON reading_progress(last_read_at DESC);
CREATE TABLE prefetch_choices (
  source_id TEXT NOT NULL,
  novel_id TEXT NOT NULL,
  chapter_id TEXT NOT NULL,
  target_id TEXT NOT NULL,
  PRIMARY KEY(source_id, novel_id, chapter_id)
);

CREATE TABLE prefetch_settings (
  id INTEGER NOT NULL PRIMARY KEY CHECK(id=1),
  current_enabled INTEGER NOT NULL,
  next_enabled INTEGER NOT NULL
);

CREATE TABLE local_books (
 digest TEXT NOT NULL PRIMARY KEY CHECK(length(digest) = 64),
 format TEXT NOT NULL CHECK(format IN ('txt', 'epub')),
 title TEXT NOT NULL,
 imported_at INTEGER NOT NULL,
 manifest_hash TEXT NOT NULL CHECK(length(manifest_hash) = 64),
 active_bundle TEXT,
 parser_version INTEGER NOT NULL DEFAULT 1,
 maintenance INTEGER NOT NULL DEFAULT 0 CHECK(maintenance IN (0,1))
);

CREATE TABLE local_chapter_revisions (
 digest TEXT NOT NULL,
 chapter_id TEXT NOT NULL,
 content_revision TEXT NOT NULL,
 catalog_revision TEXT NOT NULL,
 PRIMARY KEY(digest, chapter_id)
);

-- Durable progress basis; independent from the disposable catalog cache.
CREATE TABLE progress_catalogs (
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL,
 catalog_json TEXT NOT NULL,
 fetched_at INTEGER NOT NULL,
 origin TEXT NOT NULL CHECK(origin IN ('memory', 'local', 'remote')),
 PRIMARY KEY(source_id, novel_id)
);

-- One latest attempt per book, never a persistent work queue.
CREATE TABLE local_reparse_attempts (
 digest TEXT NOT NULL PRIMARY KEY,
 target_parser_version INTEGER NOT NULL,
 outcome TEXT NOT NULL,
 failure_count INTEGER NOT NULL DEFAULT 0 CHECK(failure_count >= 0),
 next_retry_at INTEGER,
 attempted_at INTEGER NOT NULL
);

-- Retained mutation stamp prevents late work from restoring deleted bookmarks.
CREATE TABLE bookmark_versions (
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL,
 revision INTEGER NOT NULL CHECK(revision >= 1),
 PRIMARY KEY(source_id, novel_id)
);
CREATE TABLE user_bookmarks (
 id TEXT NOT NULL PRIMARY KEY,
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL, chapter_id TEXT NOT NULL,
 anchor_json TEXT NOT NULL, chapter_title TEXT NOT NULL,
 created_at INTEGER NOT NULL, version INTEGER NOT NULL CHECK(version >= 1),
 location TEXT NOT NULL CHECK(location IN ('exact','migrated','inexact','unavailable'))
);
CREATE INDEX bookmarks_book ON user_bookmarks(source_id, novel_id, created_at DESC);

CREATE TABLE reading_statistics_state (
 id INTEGER NOT NULL PRIMARY KEY CHECK(id=1),
 enabled INTEGER NOT NULL DEFAULT 1 CHECK(enabled IN (0,1)),
 notice_seen INTEGER NOT NULL DEFAULT 0 CHECK(notice_seen IN (0,1)),
 epoch INTEGER NOT NULL DEFAULT 0 CHECK(epoch>=0),
 started_day INTEGER
);
CREATE TABLE reading_statistics_days (
 day INTEGER NOT NULL PRIMARY KEY,
 milliseconds INTEGER NOT NULL CHECK(milliseconds>=0)
);
CREATE TABLE reading_statistics_books (
 day INTEGER NOT NULL, source_id TEXT NOT NULL, novel_id TEXT NOT NULL,
 milliseconds INTEGER NOT NULL CHECK(milliseconds>=0),
 PRIMARY KEY(day,source_id,novel_id)
);
CREATE INDEX statistics_book ON reading_statistics_books(source_id,novel_id);
CREATE TABLE reading_statistics_checkpoints (
 session_id TEXT NOT NULL PRIMARY KEY,
 source_id TEXT NOT NULL, novel_id TEXT NOT NULL,
 epoch INTEGER NOT NULL, removal_generation INTEGER NOT NULL,
 sequence INTEGER NOT NULL DEFAULT 0 CHECK(sequence>=0),
 payload TEXT NOT NULL DEFAULT ''
);
