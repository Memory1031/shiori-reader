u8fd4\u56de\u6309\u94ae\u3002\r\n- \u6309\u94ae\u9690\u85cf\u540e\uff0c\u4ecd\u7136\u53ef\u4ee5\u901a\u8fc7\u9605\u8bfb\u5668\u66f4\u591a\u83dc\u5355\u8fd4\u56de\u3002\r\n- \u652f\u6301\u8fde\u7eed\u67e5\u627e\uff0c\u4ee5\u53ca\u4e66\u7b7e\u3001\u641c\u7d22\u548c\u4e66\u5185\u94fe\u63a5\u4e4b\u95f4\u7684\u591a\u6b21\u8df3\u8f6c\u3002\r\n- \u8de8\u7ae0\u8282\u67e5\u770b\u5185\u5bb9\u540e\uff0c\u4e5f\u53ef\u4ee5\u9010\u6b65\u56de\u5230\u4e4b\u524d\u7684\u9605\u8bfb\u4f4d\u7f6e\u3002\r\n\r\n\u9605\u8bfb\u65f6\u4e0d\u5fc5\u518d\u62c5\u5fc3\u67e5\u627e\u67d0\u6bb5\u5185\u5bb9\u540e\u627e\u4e0d\u5230\u539f\u6765\u7684\u4f4d\u7f6e\u3002\r\n\r\n## \u5168\u65b0 macOS \u7248\u672c\r\n\r\n**Shiori \u6b63\u5f0f\u589e\u52a0 macOS \u652f\u6301\u3002**\r\n\r\nmacOS \u7248\u672c\u5ef6\u7eed\u73b0\u6709\u7684\u684c\u9762\u9605\u8bfb\u4f53\u9a8c\uff0c\u652f\u6301\uff1a\r\n\r\n- \u672c\u5730 EPUB/TXT \u5bfc\u5165\u4e0e\u9605\u8bfb\u3002\r\n- \u62d6\u5165\u6587\u4ef6\u6216\u901a\u8fc7 Finder \u6253\u5f00\u4e66\u7c4d\u3002\r\n- \u952e\u76d8\u5feb\u6377\u952e\u3001\u9f20\u6807\u548c\u6eda\u8f6e\u7ffb\u9875\u3002\r\n- \u5bbd\u5c4f\u53cc\u9875\u9605\u8bfb\u3001\u4e66\u67b6\u7ba1\u7406\u3001\u5168\u6587\u641c\u7d22\u548c\u4e66\u7b7e\u3002\r\n- \u5728\u7ebf\u9605\u8bfb\u3001\u79bb\u7ebf\u7f13\u5b58\u53ca\u5e94\u7528\u5185\u66f4\u65b0\u3002\r\n\r\nGitHub Releases \u63d0\u4f9b\u540c\u65f6\u9002\u7528\u4e8e **Apple Silicon \u548c Intel Mac** \u7684\u901a\u7528 DMG\uff0c\u7cfb\u7edf\u8981\u6c42\u4e3a macOS 12.0 \u6216\u66f4\u65b0\u7248\u672c\u3002\r\n\r\n**\u5b89\u88c5\u63d0\u9192\uff1a** macOS \u7248\u672c\u672a\u7ecf\u8fc7 Apple \u5f00\u53d1\u8005\u8eab\u4efd\u7b7e\u540d\u53ca\u516c\u8bc1\uff0c\u9996\u6b21\u6253\u5f00\u65f6\u53ef\u80fd\u53d7\u5230\u7cfb\u7edf\u5b89\u5168\u673a\u5236\u9650\u5236\u3002\u8bf7\u5c06\u5e94\u7528\u590d\u5236\u5230\u300c\u5e94\u7528\u7a0b\u5e8f\u300d\u6587\u4ef6\u5939\u6216\u5176\u4ed6\u53ef\u5199\u4f4d\u7f6e\u540e\u8fd0\u884c\uff0c\u4e0d\u8981\u76f4\u63a5\u5728 DMG \u4e2d\u4f7f\u7528\u5e94\u7528\u5185\u66f4\u65b0\u3002\r\n\r\n## \u4e66\u67b6\u4e0e\u672c\u5730\u4e66\u7c4d\u7ba1\u7406\r\n\r\n### \u6279\u91cf\u7ba1\u7406\r\n\r\n\u4e66\u67b6\u548c\u672c\u5730\u6587\u4ef6\u7ba1\u7406\u73b0\u5728\u652f\u6301\u591a\u9009\u64cd\u4f5c\u3002\r\n\r\n- \u4e00\u6b21\u9009\u62e9\u591a\u672c\u4e66\u7c4d\u8fdb\u884c\u79fb\u9664\u3002\r\n- \u6279\u91cf\u91cd\u65b0\u89e3\u6790\u672c\u5730 EPUB/TXT\u3002\r\n- \u67e5\u770b\u6bcf\u672c\u4e66\u7684\u5904\u7406\u7ed3\u679c\u3002\r\n- \u5904\u7406\u8fc7\u7a0b\u4e2d\u53ef\u4ee5\u505c\u6b62\uff0c\u5df2\u7ecf\u5b8c\u6210\u7684\u64cd\u4f5c\u4e0d\u4f1a\u88ab\u64a4\u9500\u3002\r\n\r\n\u6279\u91cf\u64cd\u4f5c\u4f1a\u5728\u6267\u884c\u524d\u63d0\u793a\u786e\u8ba4\uff0c\u51cf\u5c11\u9010\u672c\u5904\u7406\u7684\u91cd\u590d\u64cd\u4f5c\u3002\r\n\r\n### \u65e7\u4e66\u81ea\u52a8\u66f4\u65b0\u89e3\u6790\r\n\r\n\u6b64\u524d\u5bfc\u5165\u7684 EPUB/TXT\uff0c\u73b0\u5728\u53ef\u4ee5\u5728\u9002\u5f53\u6761\u4ef6\u4e0b\u81ea\u52a8\u5e94\u7528\u65b0\u7248\u89e3\u6790\u5668\u7684\u517c\u5bb9\u6027\u6539\u8fdb\u3002\r\n\r\n- \u4e0d\u9700\u8981\u4e3a\u4e86\u83b7\u5f97\u65b0\u7684\u6392\u7248\u652f\u6301\u800c\u5220\u9664\u539f\u4e66\u3001\u91cd\u65b0\u5bfc\u5165\u3002\r\n- \u81ea\u52a8\u66f4\u65b0\u4f1a\u5c3d\u91cf\u4fdd\u7559\u5df2\u6709\u9605\u8bfb\u4f4d\u7f6e\u548c\u4e66\u7b7e\u3002\r\n- \u5982\u679c\u65e0\u6cd5\u53ef\u9760\u6062\u590d\u4f4d\u7f6e\u3001\u6587\u5b57\u7f16\u7801\u5b58\u5728\u6b67\u4e49\u6216\u9047\u5230\u5176\u4ed6\u95ee\u9898\uff0c\u4f1a\u4fdd\u7559\u539f\u6765\u7684\u4e66\u7c4d\u6570\u636e\u3002\r\n- \u4ecd\u7136\u53ef\u4ee5\u4ece\u672c\u5730\u6587\u4ef6\u7ba1\u7406\u4e2d\u624b\u52a8\u9009\u62e9\u300c\u91cd\u65b0\u89e3\u6790\u300d\u3002\r\n\r\n\u81ea\u52a8\u66f4\u65b0\u4f1a\u5728\u540e\u53f0\u5206\u6279\u8fdb\u884c\uff0c\u4e0d\u4fdd\u8bc1\u6240\u6709\u65e7\u4e66\u5728\u5347\u7ea7\u5e94\u7528\u540e\u7acb\u5373\u5b8c\u6210\u5904\u7406\u3002\r\n\r\n### \u5176\u4ed6\u4e66\u67b6\u6539\u8fdb\r\n\r\n- \u300c\u7ee7\u7eed\u9605\u8bfb\u300d\u4f18\u5148\u5c55\u793a\u5c1a\u672a\u8bfb\u5b8c\u7684\u4e66\u7c4d\u3002\r\n- \u4e66\u67b6\u7684\u7f51\u683c\u6216\u5217\u8868\u5e03\u5c40\u9009\u62e9\u73b0\u5728\u4f1a\u88ab\u8bb0\u4f4f\u3002\r\n- \u4f18\u5316\u5bfc\u5165\u7ed3\u679c\u63d0\u793a\uff0c\u66f4\u6e05\u695a\u5730\u533a\u5206\u65b0\u589e\u4e66\u7c4d\u3001\u5df2\u6709\u4e66\u7c4d\u548c\u5bfc\u5165\u5931\u8d25\u3002\r\n- \u6539\u5584\u6279\u91cf\u5bfc\u5165\u7684\u53d6\u6d88\u3001\u91cd\u8bd5\u4e0e\u5f85\u5904\u7406\u6587\u4ef6\u4fdd\u7559\u3002\r\n- \u4f18\u5316\u4e66\u67b6\u6eda\u52a8\u533a\u57df\u548c\u90e8\u5206\u7ba1\u7406\u64cd\u4f5c\u7684\u4ea4\u4e92\u3002\r\n\r\n## EPUB \u9605\u8bfb\u517c\u5bb9\u6027\u589e\u5f3a\r\n\r\n1.4.0 \u7ee7\u7eed\u6269\u5c55 Shiori \u5bf9\u8f7b\u5c0f\u8bf4 EPUB \u7684\u539f\u751f\u5206\u9875\u652f\u6301\u3002\r\n\r\n### \u66f4\u591a\u539f\u4e66\u6392\u7248\u6837\u5f0f\r\n\r\n- \u652f\u6301\u90e8\u5206 EPUB \u5185\u5d4c\u7684 TTF/OTF \u5b57\u4f53\uff0c\u5c3d\u91cf\u4fdd\u7559\u4f5c\u8005\u6307\u5b9a\u7684\u6587\u5b57\u6837\u5f0f\u3002\r\n- \u6539\u5584\u5e26\u6709\u80cc\u666f\u56fe\u7247\u3001\u8fb9\u6846\u3001\u5706\u89d2\u53ca\u88c5\u9970\u5143\u7d20\u7684\u9875\u9762\u663e\u793a\u3002\r\n- \u652f\u6301\u66f4\u591a\u7b80\u5355\u8868\u683c\u548c\u88c5\u9970\u6027\u6807\u9898\u7ed3\u6784\u3002\r\n- \u6539\u5584\u5c01\u9762\u3001\u6249\u9875\u3001\u63d2\u56fe\u548c\u4e66\u4e2d\u76ee\u5f55\u7684\u5e03\u5c40\u3002\r\n- \u4e3a\u90e8\u5206\u539f\u4e66\u7f3a\u5c11\u76ee\u5f55\u5165\u53e3\u7684\u5c01\u9762\u3001\u5f69\u63d2\u548c\u524d\u7f6e\u9875\u9762\u8865\u5145\u5bfc\u822a\u4f4d\u7f6e\u3002\r\n- \u6539\u5584\u4e66\u5185\u94fe\u63a5\u53ca\u7279\u6b8a\u7248\u5f0f\u9875\u9762\u7684\u5b9a\u4f4d\u3001\u663e\u793a\u548c\u8fd4\u56de\u884c\u4e3a\u3002\r\n\r\n\u5bf9\u4e8e\u65e0\u6cd5\u5b8c\u6574\u8fd8\u539f\u7684\u590d\u6742\u6837\u5f0f\uff0c\u9605\u8bfb\u5668\u4ecd\u7136\u4f18\u5148\u4fdd\u8bc1\u6587\u5b57\u53ef\u8bfb\uff0c\u800c\u4e0d\u662f\u5f3a\u884c\u663e\u793a\u53ef\u80fd\u9519\u4e71\u7684\u6392\u7248\u3002\r\n\r\n### EPUB \u5185\u5d4c\u97f3\u9891\r\n\r\n\u90e8\u5206 EPUB \u5305\u542b\u4f5c\u8005\u63d0\u4f9b\u7684\u97f3\u9891\u5185\u5bb9\uff0c\u73b0\u5728\u53ef\u4ee5\u5728\u9605\u8bfb\u5668\u4e2d\u4f7f\u7528\u76f8\u5e94\u7684\u64ad\u653e\u4e0e\u6682\u505c\u63a7\u4ef6\u3002\r\n\r\n\u76ee\u524d\u652f\u6301\u7b26\u5408\u6761\u4ef6\u7684\u5305\u5185 MP3 \u548c WAV \u6587\u4ef6\u3002\u97f3\u9891\u4e0d\u4f1a\u81ea\u52a8\u64ad\u653e\uff0c\u4e5f\u4e0d\u652f\u6301\u540e\u53f0\u64ad\u653e\u6216\u4e0e\u6b63\u6587\u540c\u6b65\u6717\u8bfb\u3002\r\n\r\n### \u9605\u8bfb\u5668\u7ec6\u8282\r\n\r\n- \u7ffb\u9875\u65f6\u7684\u7ae0\u8282\u8fdb\u5ea6\u663e\u793a\u66f4\u52a0\u53ca\u65f6\u3002\r\n- \u4ece\u641c\u7d22\u7ed3\u679c\u3001\u4e66\u7b7e\u6216\u4e66\u5185\u94fe\u63a5\u8df3\u8f6c\u65f6\uff0c\u589e\u52a0\u66f4\u81ea\u7136\u7684\u4f4d\u7f6e\u5207\u6362\u6548\u679c\u3002\r\n- \u6253\u5f00\u76ee\u5f55\u540e\uff0c\u53ef\u4ee5\u66f4\u65b9\u4fbf\u5730\u627e\u5230\u5f53\u524d\u9605\u8bfb\u7684\u5c0f\u8282\u3002\r\n- \u5173\u95ed\u5e76\u91cd\u65b0\u6253\u5f00\u76ee\u5f55\u65f6\uff0c\u5728\u9002\u5f53\u6761\u4ef6\u4e0b\u4fdd\u7559\u4e4b\u524d\u6d4f\u89c8\u7684\u4f4d\u7f6e\u548c\u5c55\u5f00\u72b6\u6001\u3002\r\n- \u9605\u8bfb\u8bbe\u7f6e\u4e0e\u5f39\u51fa\u83dc\u5355\u7684\u989c\u8272\u66f4\u52a0\u7edf\u4e00\uff0c\u6696\u7eb8\u548c\u591c\u95f4\u4e3b\u9898\u4e0b\u7684\u663e\u793a\u6548\u679c\u8fdb\u4e00\u6b65\u6539\u5584\u3002\r\n- \u4f18\u5316\u90e8\u5206\u9605\u8bfb\u52a0\u8f7d\u3001\u7ffb\u9875\u548c\u4f4d\u7f6e\u6062\u590d\u573a\u666f\uff0c\u51cf\u5c11\u4e0d\u5fc5\u8981\u7684\u753b\u9762\u53d8\u5316\u3002\r\n\r\n## \u5728\u7ebf\u9605\u8bfb\u4e0e\u79bb\u7ebf\u4f53\u9a8c\r\n\r\n- \u4f18\u5316\u5728\u7ebf\u4e66\u7c4d\u7684\u76ee\u5f55\u52a0\u8f7d\u4e0e\u5237\u65b0\uff0c\u7f3a\u5c11\u76ee\u5f55\u6570\u636e\u65f6\u53ef\u6309\u9700\u83b7\u53d6\u3002\r\n- \u9605\u8bfb\u5668\u76ee\u5f55\u53ef\u4ee5\u6807\u8bb0\u5f53\u524d\u6b63\u6587\u5c0f\u8282\u3002\r\n- \u5728\u7ebf\u4e66\u7c4d\u7684\u5df2\u7f13\u5b58\u5185\u5bb9\u73b0\u5728\u53ef\u4ee5\u76f4\u63a5\u4ece\u7f13\u5b58\u7ba1\u7406\u9875\u9762\u6253\u5f00\u9605\u8bfb\u3002\r\n- \u6539\u5584\u7ae0\u8282\u9884\u53d6\u3001\u79bb\u7ebf\u5185\u5bb9\u5207\u6362\u548c\u53d6\u6d88\u64cd\u4f5c\u7684\u7a33\u5b9a\u6027\u3002\r\n- \u4f18\u5316\u7f51\u7edc\u5f02\u5e38\u3001\u9605\u8bfb\u8fdb\u5ea6\u4fdd\u5b58\u5931\u8d25\u7b49\u60c5\u51b5\u7684\u63d0\u793a\u4e0e\u91cd\u8bd5\u3002\r\n\r\n\u5728\u7ebf\u9605\u8bfb\u4ecd\u4f9d\u8d56\u7b2c\u4e09\u65b9\u4e66\u6e90\uff0c\u5df2\u7f13\u5b58\u5185\u5bb9\u7684\u79bb\u7ebf\u53ef\u7528\u6027\u53d6\u51b3\u4e8e\u5b9e\u9645\u4fdd\u5b58\u7684\u7ae0\u8282\u548c\u8d44\u6e90\u3002\r\n\r\n## \u754c\u9762\u4e0e\u7a33\u5b9a\u6027\u6539\u8fdb\r\n\r\n- \u8c03\u6574 Android\u3001iOS \u548c Windows \u7684\u539f\u751f\u542f\u52a8\u753b\u9762\uff0c\u4f7f\u5176\u4e0e Shiori \u7684\u6574\u4f53\u89c6\u89c9\u66f4\u52a0\u4e00\u81f4\u3002\r\n- \u7edf\u4e00\u90e8\u5206\u64cd\u4f5c\u6210\u529f\u3001\u5931\u8d25\u548c\u91cd\u8bd5\u63d0\u793a\u7684\u663e\u793a\u65b9\u5f0f\u3002\r\n- \u6539\u5584\u6b63\u5e38\u9000\u51fa\u5e94\u7528\u65f6\u7684\u9605\u8bfb\u8fdb\u5ea6\u4fdd\u5b58\u3002\r\n- \u63d0\u9ad8\u5bfc\u5165\u3001\u5220\u9664\u3001\u91cd\u65b0\u89e3\u6790\u4ee5\u53ca\u7f13\u5b58\u7ba1\u7406\u8fc7\u7a0b\u4e2d\u7684\u6570\u636e\u5904\u7406\u53ef\u9760\u6027\u3002\r\n- \u4fee\u590d\u591a\u9879\u6d89\u53ca\u9605\u8bfb\u4f4d\u7f6e\u3001\u7ae0\u8282\u5207\u6362\u3001\u5f02\u6b65\u52a0\u8f7d\u548c\u53d6\u6d88\u64cd\u4f5c\u7684\u95ee\u9898\u3002\r\n\r\n## \u4e0b\u8f7d\u4e0e\u5b89\u88c5\r\n\r\n1.4.0 \u901a\u8fc7 GitHub Releases \u63d0\u4f9b\u4ee5\u4e0b\u5b89\u88c5\u6587\u4ef6\uff1a\r\n\r\n| \u5e73\u53f0                 | \u5206\u53d1\u65b9\u5f0f                         |\r\n| ------------------ | ---------------------------- |\r\n| Android 7.0+       | \u5df2\u7b7e\u540d APK                      |\r\n| Windows x64        | \u4fbf\u643a ZIP                     